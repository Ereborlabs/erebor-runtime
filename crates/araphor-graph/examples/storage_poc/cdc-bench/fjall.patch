+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{KeyspaceCreateOptions, Readable, SingleWriterTxDatabase};
+    use std::time::Duration;
+
+    fn database(path: &Path) -> crate::Result<SingleWriterTxDatabase> {
+        SingleWriterTxDatabase::builder(path).journal_cdc().open()
+    }
+
+    #[test]
+    fn empty_reopen_and_first_batch() -> crate::Result<()> {
+        let dir = tempfile::tempdir()?;
+        drop(database(dir.path())?);
+        let db = database(dir.path())?;
+        assert!(db
+            .inner()
+            .journal_feed(Some(Cursor {
+                journal: 0,
+                offset: 8,
+                sequence: 0
+            }))
+            .is_err());
+        let mut feed = db.inner().journal_feed(None)?;
+        assert!(feed.read()?.is_empty());
+        let table = db.keyspace("records", KeyspaceCreateOptions::default)?;
+        table.insert("a", "first")?;
+        let mut future = db.inner().journal_head()?.unwrap();
+        future.offset += 1;
+        assert!(db.inner().journal_feed(Some(future)).is_err());
+        let batches = feed.read()?;
+        assert_eq!(batches.len(), 1);
+        assert_eq!(
+            batches[0].items[0].value.as_deref(),
+            Some(b"first".as_slice())
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn raw_mutations_and_rollback() -> crate::Result<()> {
+        let dir = tempfile::tempdir()?;
+        let db = database(dir.path())?;
+        let table = db.keyspace("records", KeyspaceCreateOptions::default)?;
+        let mut feed = db.inner().journal_feed(None)?;
+        table.insert("a", "old")?;
+        table.insert("a", "new")?;
+        table.remove("a")?;
+        table.as_ref().remove_weak("b")?;
+        table.insert("empty", "")?;
+        table.as_ref().clear()?;
+        let mut aborted = db.write_tx().durability(None);
+        aborted.insert(&table, "rollback", "absent");
+        aborted.rollback();
+        let batches = feed.read()?;
+        assert_eq!(batches.len(), 6);
+        assert!(batches
+            .windows(2)
+            .all(|pair| pair[0].cursor.sequence < pair[1].cursor.sequence));
+        assert_eq!(
+            batches[0].items[0].value.as_deref(),
+            Some(b"old".as_slice())
+        );
+        assert_eq!(
+            batches[1].items[0].value.as_deref(),
+            Some(b"new".as_slice())
+        );
+        assert!(batches[2].items[0].value.is_none());
+        assert!(batches[3].items[0].value.is_none());
+        assert_eq!(batches[4].items[0].value.as_deref(), Some(b"".as_slice()));
+        assert_eq!(batches[5].clears, vec![table.as_ref().id()]);
+        Ok(())
+    }
+
+    #[test]
+    fn unread_rotation_compaction_and_clear_recovery() -> crate::Result<()> {
+        let dir = tempfile::tempdir()?;
+        let db = database(dir.path())?;
+        let table = db.keyspace("records", KeyspaceCreateOptions::default)?;
+        table.insert("a", "old")?;
+        let cursor = db.inner().journal_head()?.unwrap();
+        table.as_ref().flush(true)?;
+        table.as_ref().clear()?;
+        table.insert("a", "new")?;
+        table.as_ref().flush(true)?;
+        db.inner().rotate_journal()?;
+        table.insert("b", "latest")?;
+        table.as_ref().flush(true)?;
+        table.as_ref().major_compact()?;
+        db.inner().collect_journals()?;
+        assert!(dir.path().join(format!("{}.jnl", cursor.journal)).exists());
+        drop(table);
+        drop(db);
+        let db = database(dir.path())?;
+        let table = db.keyspace("records", KeyspaceCreateOptions::default)?;
+        assert_eq!(
+            db.read_tx().get(&table, "a")?.as_deref(),
+            Some(b"new".as_slice())
+        );
+        assert_eq!(
+            db.read_tx().get(&table, "b")?.as_deref(),
+            Some(b"latest".as_slice())
+        );
+        let mut feed = db.inner().journal_feed(Some(cursor))?;
+        let batches = feed.read()?;
+        assert_eq!(batches.len(), 3);
+        assert_eq!(batches[0].clears, vec![table.as_ref().id()]);
+        assert_eq!(
+            batches[1].items[0].value.as_deref(),
+            Some(b"new".as_slice())
+        );
+        assert_eq!(
+            batches[2].items[0].value.as_deref(),
+            Some(b"latest".as_slice())
+        );
+        db.inner().retain_after(batches[2].cursor)?;
+        db.inner().collect_journals()?;
+        assert!(!dir.path().join(format!("{}.jnl", cursor.journal)).exists());
+        assert!(db.inner().journal_feed(Some(cursor))?.read().is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn poison_wakes_blocked_reader() -> crate::Result<()> {
+        let dir = tempfile::tempdir()?;
+        let db = database(dir.path())?;
+        let mut feed = db.inner().journal_feed(None)?;
+        feed.read()?;
+        let cancel = feed.cancellation();
+        let (send, receive) = std::sync::mpsc::channel();
+        let thread = std::thread::spawn(move || send.send(feed.wait().is_err()).unwrap());
+        crate::poison::PoisonDart::new(db.inner().is_poisoned.clone(), &db.inner().config).poison();
+        let result = receive.recv_timeout(Duration::from_secs(5));
+        cancel.stop();
+        thread.join().unwrap();
+        assert!(result.unwrap());
+        Ok(())
+    }
+
+    #[test]
+    fn corrupt_reader_does_not_truncate() -> crate::Result<()> {
+        use std::io::{Seek, SeekFrom, Write};
+        let dir = tempfile::tempdir()?;
+        let db = database(dir.path())?;
+        let table = db.keyspace("records", KeyspaceCreateOptions::default)?;
+        table.insert("a", "value")?;
+        let cursor = db.inner().journal_head()?.unwrap();
+        let path = dir.path().join(format!("{}.jnl", cursor.journal));
+        let length = path.metadata()?.len();
+        let mut file = std::fs::OpenOptions::new().write(true).open(&path)?;
+        file.seek(SeekFrom::Start(cursor.offset - 1))?;
+        file.write_all(&[0])?;
+        file.sync_all()?;
+        assert!(db.inner().journal_feed(None)?.read().is_err());
+        assert_eq!(path.metadata()?.len(), length);
+        Ok(())
+    }
+}
