diff --git a/src/cdc.rs b/src/cdc.rs
new file mode 100644
--- /dev/null
+++ b/src/cdc.rs
@@ -0,0 +1,518 @@
+//! Read committed native journal batches from a retained cursor.
+use crate::journal::{batch_reader::JournalBatchReader, reader::JournalReader, writer::Writer};
+use crate::{Database, Slice};
+use std::io::{Error, ErrorKind};
+use std::path::Path;
+use std::sync::{
+    atomic::{AtomicBool, AtomicU64, Ordering},
+    Arc, Condvar, Mutex,
+};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+/// The end of one complete, durable journal batch.
+pub struct Cursor {
+    /// The physical journal identity.
+    pub journal: u64,
+    /// The byte offset after the batch terminator.
+    pub offset: u64,
+    /// The native batch sequence number.
+    pub sequence: u64,
+}
+
+/// One native key mutation.
+pub struct Item {
+    /// The native keyspace identity.
+    pub keyspace: u64,
+    /// The original stored key.
+    pub key: Slice,
+    /// The stored value, or no value for a deletion.
+    pub value: Option<Slice>,
+}
+
+/// One complete transaction from the original journal.
+pub struct Batch {
+    /// The position after this transaction.
+    pub cursor: Cursor,
+    /// The original key mutations.
+    pub items: Vec<Item>,
+    /// The keyspaces cleared by this transaction.
+    pub clears: Vec<u64>,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct Signal {
+    head: Mutex<Option<Cursor>>,
+    ready: Condvar,
+    ack: AtomicU64,
+}
+
+fn invalid(message: &str) -> crate::Error {
+    Error::new(ErrorKind::InvalidData, message).into()
+}
+
+fn journal_id(path: &Path) -> crate::Result<u64> {
+    path.file_stem()
+        .and_then(|s| s.to_str())
+        .and_then(|s| s.parse().ok())
+        .ok_or_else(|| invalid("invalid journal identity"))
+}
+
+impl Signal {
+    pub(crate) fn publish(&self, writer: &mut Writer, sequence: u64) -> crate::Result<()> {
+        let offset = writer.pos()?;
+        self.restore(writer, offset, sequence)
+    }
+
+    pub(crate) fn restore(
+        &self,
+        writer: &mut Writer,
+        offset: u64,
+        sequence: u64,
+    ) -> crate::Result<()> {
+        self.recover(&writer.path, offset, sequence)
+    }
+
+    pub(crate) fn recover(&self, path: &Path, offset: u64, sequence: u64) -> crate::Result<()> {
+        let cursor = Cursor {
+            journal: journal_id(path)?,
+            offset,
+            sequence,
+        };
+        *self.head.lock().map_err(|_| crate::Error::Poisoned)? = Some(cursor);
+        self.ready.notify_all();
+        Ok(())
+    }
+
+    pub(crate) fn last_sequence(&self, path: &Path) -> Option<u64> {
+        let id = journal_id(path).ok()?;
+        self.head
+            .lock()
+            .ok()?
+            .filter(|cursor| cursor.journal == id && cursor.offset > 0)
+            .map(|cursor| cursor.sequence)
+    }
+
+    pub(crate) fn poison(&self, poison: &crate::poison::PoisonSignal) {
+        let _guard = self
+            .head
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        poison.poison();
+        self.ready.notify_all();
+    }
+
+    pub(crate) fn floor(&self) -> u64 {
+        self.ack.load(Ordering::Acquire)
+    }
+}
+
+/// A non-mutating journal reader with a private scan cursor.
+pub struct Feed {
+    db: Database,
+    signal: Arc<Signal>,
+    cursor: Option<Cursor>,
+    stopped: Arc<AtomicBool>,
+}
+
+#[derive(Clone)]
+/// A stop handle for one blocked reader.
+pub struct Cancel {
+    signal: Arc<Signal>,
+    stopped: Arc<AtomicBool>,
+}
+
+impl Cancel {
+    /// Stops this reader without publishing a data change.
+    pub fn stop(&self) {
+        let _guard = self.signal.head.lock().expect("journal signal poisoned");
+        self.stopped.store(true, Ordering::Release);
+        self.signal.ready.notify_all();
+    }
+}
+
+impl Database {
+    /// Starts after a saved cursor, or at the earliest retained journal.
+    pub fn journal_feed(&self, cursor: Option<Cursor>) -> crate::Result<Feed> {
+        let signal = self
+            .config
+            .cdc
+            .clone()
+            .ok_or_else(|| invalid("journal CDC is disabled"))?;
+        let head = *signal.head.lock().map_err(|_| crate::Error::Poisoned)?;
+        if cursor.is_some_and(|cursor| head.is_none_or(|head| cursor > head)) {
+            return Err(invalid("journal cursor exceeds committed head"));
+        }
+        Ok(Feed {
+            db: self.clone(),
+            signal,
+            cursor,
+            stopped: Arc::default(),
+        })
+    }
+
+    /// Returns the complete durable journal boundary.
+    pub fn journal_head(&self) -> crate::Result<Option<Cursor>> {
+        let signal = self
+            .config
+            .cdc
+            .as_ref()
+            .ok_or_else(|| invalid("journal CDC is disabled"))?;
+        Ok(*signal.head.lock().map_err(|_| crate::Error::Poisoned)?)
+    }
+
+    /// Releases history before a cursor that the caller has durably saved.
+    /// Keep the minimum cursor of all consumers. Start with no acknowledgement after reopen.
+    pub fn retain_after(&self, cursor: Cursor) -> crate::Result<()> {
+        let signal = self
+            .config
+            .cdc
+            .as_ref()
+            .ok_or_else(|| invalid("journal CDC is disabled"))?;
+        if self.journal_head()?.is_none_or(|head| cursor > head) {
+            return Err(invalid("journal acknowledgement exceeds committed head"));
+        }
+        signal.ack.fetch_max(cursor.sequence, Ordering::AcqRel);
+        Ok(())
+    }
+
+    /// Seals the current native journal.
+    pub fn rotate_journal(&self) -> crate::Result<()> {
+        let mut writer = self.supervisor.journal.get_writer()?;
+        let mut manager = self
+            .supervisor
+            .journal_manager
+            .write()
+            .map_err(|_| crate::Error::Poisoned)?;
+        let keyspaces = self
+            .supervisor
+            .keyspaces
+            .write()
+            .map_err(|_| crate::Error::Poisoned)?;
+        let watermarks = self.supervisor.build_seqno_map(&keyspaces);
+        manager.rotate_journal(&mut writer, watermarks)
+    }
+
+    /// Removes fully flushed journals below the acknowledged cursor.
+    pub fn collect_journals(&self) -> crate::Result<()> {
+        self.supervisor
+            .journal_manager
+            .write()
+            .map_err(|_| crate::Error::Poisoned)?
+            .maintenance()
+    }
+}
+
+impl Feed {
+    /// Returns a stop handle for this reader.
+    pub fn cancellation(&self) -> Cancel {
+        Cancel {
+            signal: self.signal.clone(),
+            stopped: self.stopped.clone(),
+        }
+    }
+
+    /// Waits for a durable batch or cancellation.
+    pub fn wait(&self) -> crate::Result<bool> {
+        let mut head = self
+            .signal
+            .head
+            .lock()
+            .map_err(|_| crate::Error::Poisoned)?;
+        while *head <= self.cursor
+            && !self.stopped.load(Ordering::Acquire)
+            && !self.db.is_poisoned.is_poisoned()
+        {
+            head = self
+                .signal
+                .ready
+                .wait(head)
+                .map_err(|_| crate::Error::Poisoned)?;
+        }
+        if self.db.is_poisoned.is_poisoned() {
+            return Err(crate::Error::Poisoned);
+        }
+        Ok(!self.stopped.load(Ordering::Acquire))
+    }
+
+    /// Returns the in-memory scan position, which is not an acknowledgement.
+    pub fn cursor(&self) -> Option<Cursor> {
+        self.cursor
+    }
+
+    /// Reads original journal bytes through the captured durable boundary.
+    pub fn read(&mut self) -> crate::Result<Vec<Batch>> {
+        if self.db.is_poisoned.is_poisoned() {
+            return Err(crate::Error::Poisoned);
+        }
+        let Some(upper) = *self
+            .signal
+            .head
+            .lock()
+            .map_err(|_| crate::Error::Poisoned)?
+        else {
+            return Ok(Vec::new());
+        };
+        if self.cursor.is_some_and(|cursor| cursor > upper) {
+            return Err(invalid("journal cursor exceeds committed head"));
+        }
+        if self.cursor == Some(upper) {
+            return Ok(Vec::new());
+        }
+        let mut start = self.cursor.map_or(0, |cursor| cursor.journal);
+        let files = {
+            let mut writer = self.db.supervisor.journal.get_writer()?;
+            if self.db.is_poisoned.is_poisoned() {
+                return Err(crate::Error::Poisoned);
+            }
+            let manager = self
+                .db
+                .supervisor
+                .journal_manager
+                .read()
+                .map_err(|_| crate::Error::Poisoned)?;
+            if self.cursor.is_none() {
+                start = manager
+                    .items
+                    .first()
+                    .map(|item| journal_id(&item.path))
+                    .transpose()?
+                    .unwrap_or(journal_id(&writer.path)?);
+            }
+            let mut files = Vec::new();
+            for item in &manager.items {
+                let id = journal_id(&item.path)?;
+                if id >= start && id <= upper.journal {
+                    files.push((id, item.path.clone(), item.end));
+                }
+            }
+            let id = journal_id(&writer.path)?;
+            if id >= start && id <= upper.journal {
+                files.push((id, writer.path.clone(), writer.pos()?));
+            }
+            files
+        };
+        if files.first().is_none_or(|(id, _, _)| *id != start)
+            || files.last().is_none_or(|(id, _, _)| *id != upper.journal)
+        {
+            return Err(invalid("journal cursor is outside retained history"));
+        }
+        let mut batches = Vec::new();
+        let mut expected = start;
+        let mut sequence = self
+            .cursor
+            .filter(|cursor| cursor.offset > 0)
+            .map(|cursor| cursor.sequence);
+        for (id, path, length) in files {
+            if id != expected {
+                return Err(invalid("retained journal segment is missing"));
+            }
+            expected += 1;
+            let offset = self
+                .cursor
+                .filter(|cursor| cursor.journal == id)
+                .map_or(0, |cursor| cursor.offset);
+            let end = if id == upper.journal {
+                upper.offset
+            } else {
+                length
+            };
+            if offset > end {
+                return Err(invalid("journal cursor exceeds segment end"));
+            }
+            let mut reader = JournalBatchReader::new(JournalReader::read_only(&path, offset, end)?);
+            while let Some(batch) = reader.next() {
+                let batch = batch?;
+                if reader.last_valid_pos > end
+                    || sequence.is_some_and(|previous| batch.seqno <= previous)
+                {
+                    return Err(invalid("journal batch position is invalid"));
+                }
+                sequence = Some(batch.seqno);
+                let cursor = Cursor {
+                    journal: id,
+                    offset: reader.last_valid_pos,
+                    sequence: batch.seqno,
+                };
+                let items = batch
+                    .items
+                    .into_iter()
+                    .map(|item| Item {
+                        keyspace: item.keyspace_id,
+                        key: item.key,
+                        value: matches!(item.value_type, lsm_tree::ValueType::Value)
+                            .then_some(item.value),
+                    })
+                    .collect();
+                batches.push(Batch {
+                    cursor,
+                    items,
+                    clears: batch.cleared_keyspaces,
+                });
+            }
+            if offset != end && reader.last_valid_pos != end {
+                return Err(invalid("journal batch did not reach committed end"));
+            }
+        }
+        self.cursor = Some(upper);
+        Ok(batches)
+    }
+}
