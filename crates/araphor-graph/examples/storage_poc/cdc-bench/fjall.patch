+impl Config {
+    pub(crate) fn durable_mode(
+        &self,
+        requested: Option<crate::PersistMode>,
+    ) -> Option<crate::PersistMode> {
+        #[cfg(feature = "journal-cdc")]
+        if self.cdc.is_some() {
+            return Some(crate::PersistMode::SyncAll);
+        }
+        requested
+    }
+
+    pub(crate) fn publish_cdc(
+        &self,
+        _writer: &mut crate::journal::writer::Writer,
+        _seqno: u64,
+    ) -> crate::Result<()> {
+        #[cfg(feature = "journal-cdc")]
+        if let Some(signal) = &self.cdc {
+            signal.publish(_writer, _seqno)?;
+        }
+        Ok(())
+    }
+}
+
+impl Config {
+    pub(crate) fn poison_cdc(&self, poison: &crate::poison::PoisonSignal) {
+        #[cfg(feature = "journal-cdc")]
+        if let Some(signal) = &self.cdc {
+            signal.poison(poison);
+            return;
+        }
+        poison.poison();
+    }
+}
