@@ -282,0 +283,47 @@ impl DeltaLayer {
+    #[cfg(feature = "benchmarking")]
+    pub async fn image_for_bench(
+        &self,
+        key: Key,
+        lsn: Lsn,
+        ctx: &RequestContext,
+    ) -> Result<Option<bytes::Bytes>> {
+        let inner = self.load(ctx).await?;
+        let reader = DiskBtreeReader::<_, DELTA_KEY_SIZE>::new(
+            inner.index_start_blk,
+            inner.index_root_blk,
+            FileBlockReader::new(&inner.file, inner.file_id),
+        );
+        let Some(offset) = reader
+            .get(&DeltaKey::from_key_lsn(&key, lsn).0, ctx)
+            .await?
+        else {
+            return Ok(None);
+        };
+        let value = ValueRef {
+            blob_ref: BlobRef(offset),
+            layer: inner,
+        }
+        .load(ctx)
+        .await?;
+        match value {
+            Value::Image(bytes) => Ok(Some(bytes)),
+            Value::WalRecord(_) => anyhow::bail!("benchmark expects image values"),
+        }
+    }
+
+    #[cfg(feature = "benchmarking")]
+    pub async fn images_for_bench(
+        &self,
+        ctx: &RequestContext,
+    ) -> Result<Vec<(Key, Lsn, bytes::Bytes)>> {
+        let inner = self.load(ctx).await?;
+        let mut values = Vec::new();
+        for entry in inner.index_entries(ctx).await? {
+            match entry.val.load(ctx).await? {
+                Value::Image(bytes) => values.push((entry.key, entry.lsn, bytes)),
+                Value::WalRecord(_) => anyhow::bail!("benchmark expects image values"),
+            }
+        }
+        Ok(values)
+    }
