 pub use crate::tree::inner::MemtableId;
 
+trait LookupKey {
+    fn parts(&self) -> (&[u8], SeqNo);
+}
+
+impl LookupKey for InternalKey {
+    fn parts(&self) -> (&[u8], SeqNo) {
+        (&self.user_key, self.seqno)
+    }
+}
+
+impl LookupKey for (&[u8], SeqNo) {
+    fn parts(&self) -> (&[u8], SeqNo) {
+        *self
+    }
+}
+
+impl<'a> Borrow<dyn LookupKey + 'a> for InternalKey {
+    fn borrow(&self) -> &(dyn LookupKey + 'a) {
+        self
+    }
+}
+
+impl PartialEq for dyn LookupKey + '_ {
+    fn eq(&self, other: &Self) -> bool {
+        self.cmp(other).is_eq()
+    }
+}
+
+impl Eq for dyn LookupKey + '_ {}
+
+impl PartialOrd for dyn LookupKey + '_ {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Ord for dyn LookupKey + '_ {
+    fn cmp(&self, other: &Self) -> Ordering {
+        let (key, seqno) = self.parts();
+        let (other_key, other_seqno) = other.parts();
+        (key, other_seqno).cmp(&(other_key, seqno))
+    }
+}
