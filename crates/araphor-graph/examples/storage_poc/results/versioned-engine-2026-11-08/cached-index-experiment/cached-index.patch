+    cache: &Cache,
+    handle: &BlockHandle,
+    compression: CompressionType,
+    #[cfg(feature = "metrics")] metrics: &Metrics,
+) -> crate::Result<CachedIndexBlock> {
+    if let Some(block) = cache.get_index_block(table_id, handle.offset()) {
+        #[cfg(feature = "metrics")]
+        metrics
+            .index_block_load_cached
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        return Ok(block);
+    }
+    let block = load_block(
+        table_id,
+        path,
+        file_accessor,
+        cache,
+        handle,
+        BlockType::Index,
+        compression,
+        #[cfg(feature = "metrics")]
+        metrics,
+    )?;
+    let block = CachedIndexBlock::new(IndexBlock::new(block));
+    cache.insert_index_block(table_id, handle.offset(), block.clone());
+    Ok(block)
