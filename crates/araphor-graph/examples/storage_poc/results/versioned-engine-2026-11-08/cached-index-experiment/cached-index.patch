+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{table::block::Header, Checksum};
+
+    #[test]
+    fn cached_restart_keys_match_raw_seeks() -> crate::Result<()> {
+        for key_size in [1, 512] {
+            let mut items = Vec::new();
+            for first in [b'a', b'c', b'e'] {
+                let mut key = vec![first];
+                key.resize(key_size, b'x');
+                for seqno in [SeqNo::MAX].into_iter().chain((0..64).rev()) {
+                    let offset = BlockOffset(items.len() as u64 * 70_000);
+                    items.push(KeyedBlockHandle::new(
+                        key.clone().into(),
+                        seqno,
+                        BlockHandle::new(offset, 6_000),
+                    ));
+                }
+            }
+            let data: Slice = IndexBlock::encode_into_vec(&items)?.into();
+            let raw = IndexBlock::new(Block {
+                header: Header {
+                    block_type: super::super::block::BlockType::Index,
+                    checksum: Checksum::from_raw(0),
+                    data_length: data.len() as u32,
+                    uncompressed_length: data.len() as u32,
+                },
+                data,
+            });
+            assert_eq!(
+                Trailer::new(&raw.inner).as_slice().get(1),
+                Some(if key_size == 1 { &2 } else { &4 }),
+            );
+            let cached = CachedIndexBlock::new(raw.clone());
+            let fields = |item: IndexBlockParsedItem| {
+                let item = item.materialize(raw.as_slice());
+                (
+                    item.end_key().clone(),
+                    item.seqno(),
+                    item.offset(),
+                    item.size(),
+                )
+            };
+            let first = items.first().expect("first key").end_key();
+            let last = items.last().expect("last key").end_key();
+            for needle in [b"".as_slice(), first.as_ref(), b"b", last.as_ref(), b"z"] {
+                for cut in [0, 1, 17, 33, 63, 64, 65, SeqNo::MAX] {
+                    let mut plain = raw.iter();
+                    let mut prepared = cached.iter();
+                    assert_eq!(plain.seek(needle, cut), prepared.seek(needle, cut));
+                    assert_eq!(
+                        plain.map(fields).collect::<Vec<_>>(),
+                        prepared.map(fields).collect::<Vec<_>>(),
+                    );
+
+                    let mut plain = raw.iter();
+                    let mut prepared = cached.iter();
+                    assert_eq!(
+                        plain.seek_upper(needle, cut),
+                        prepared.seek_upper(needle, cut)
+                    );
+                    let mut reverse = false;
+                    loop {
+                        let (a, b) = if reverse {
+                            (plain.next_back(), prepared.next_back())
+                        } else {
+                            (plain.next(), prepared.next())
+                        };
+                        let finished = a.is_none();
+                        assert_eq!(a.map(fields), b.map(fields));
+                        if finished {
+                            assert_eq!(plain.next().map(fields), prepared.next().map(fields));
+                            assert_eq!(
+                                plain.next_back().map(fields),
+                                prepared.next_back().map(fields)
+                            );
+                            break;
+                        }
+                        reverse = !reverse;
+                    }
+                    assert_eq!(
+                        raw.iter().rev().map(fields).collect::<Vec<_>>(),
+                        cached.iter().rev().map(fields).collect::<Vec<_>>(),
+                    );
+                }
+            }
+        }
+        Ok(())
+    }
+}
