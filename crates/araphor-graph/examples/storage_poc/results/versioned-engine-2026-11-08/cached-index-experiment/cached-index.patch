+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        table::{
+            block::BlockType,
+            block_index::{iter::OwnedIndexBlockIter, FullBlockIndex},
+            BlockHandle, IndexBlock, KeyedBlockHandle,
+        },
+        Checksum,
+    };
+    use std::sync::Arc;
+
+    #[test]
+    fn index_metadata_weight_replacement_and_lifetime() -> crate::Result<()> {
+        let item = KeyedBlockHandle::new(b"key".into(), 5, BlockHandle::new(BlockOffset(0), 6_000));
+        let data: crate::Slice = IndexBlock::encode_into_vec(&[item])?.into();
+        let raw = Block {
+            header: Header {
+                block_type: BlockType::Index,
+                checksum: Checksum::from_raw(0),
+                data_length: data.len() as u32,
+                uncompressed_length: data.len() as u32,
+            },
+            data,
+        };
+        let index = CachedIndexBlock::new(IndexBlock::new(raw.clone()));
+        let raw_weight =
+            Header::serialized_len() as u64 + u64::from(raw.header.uncompressed_length);
+        let weight = raw_weight + index.metadata_size() as u64;
+        let pinned = FullBlockIndex::new(index.block.clone());
+        assert_eq!(pinned.cached().size(), raw.size() + index.metadata_size());
+        assert!(pinned.cached().size() > pinned.inner().inner.size());
+        let disabled = Cache::with_capacity_bytes(0);
+        disabled.insert_index_block((9, 17).into(), BlockOffset(123), pinned.cached().clone());
+        assert_eq!(disabled.size(), 0);
+        assert!(disabled
+            .get_index_block((9, 17).into(), BlockOffset(123))
+            .is_none());
+        drop(disabled);
+        drop(pinned);
+
+        let cache = Cache::with_capacity_bytes(1_000_000);
+        let id: GlobalTableId = (9, 17).into();
+        let offset = BlockOffset(123);
+        cache.insert_block(id, offset, raw.clone());
+        assert_eq!(cache.size(), raw_weight);
+        assert!(cache.get_index_block(id, offset).is_none());
+        cache.insert_index_block(id, offset, index.clone());
+        assert_eq!(cache.size(), weight);
+        assert_eq!(
+            cache.get_block(id, offset).expect("raw block").data,
+            raw.data
+        );
+        let weak = Arc::downgrade(&index.restart_keys);
+        let mut iter = OwnedIndexBlockIter::from_cached(
+            cache.get_index_block(id, offset).expect("cached index"),
+        );
+        drop(index);
+        cache.insert_block(id, offset, raw.clone());
+        assert_eq!(cache.size(), raw_weight);
+        assert!(cache.get_index_block(id, offset).is_none());
+        assert!(weak.upgrade().is_some());
+        drop(cache);
+        drop(raw);
+        assert!(iter.seek_lower(b"key", 6));
+        let item = iter.next().expect("owned entry");
+        assert_eq!(item.end_key().as_ref(), b"key");
+        assert_eq!(item.seqno(), 5);
+        assert_eq!(item.size(), 6_000);
+        assert!(iter.next_back().is_none());
+        drop(iter);
+        assert!(weak.upgrade().is_none());
+
+        Ok(())
+    }
+}
