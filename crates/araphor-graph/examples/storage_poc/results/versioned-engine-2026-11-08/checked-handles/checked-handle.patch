     }
@@ -126,3 +144,51 @@ impl IndexBlock {
         serializer.finish()
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn borrowed_handles_keep_bounds() {
+        let bytes: Slice = b"abcdef".into();
+        for (prefix, end_key, expected) in [
+            (None, SliceIndexes(1, 4), &b"bcd"[..]),
+            (Some(SliceIndexes(0, 2)), SliceIndexes(3, 6), &b"abdef"[..]),
+        ] {
+            let item = IndexBlockParsedItem {
+                offset: BlockOffset(17),
+                size: 4096,
+                prefix,
+                end_key,
+                seqno: 3,
+            };
+            let handle = item.handle(&bytes);
+            assert_eq!(*handle.offset(), 17);
+            assert_eq!(handle.size(), 4096);
+            assert_eq!(item.materialize(&bytes).end_key().as_ref(), expected);
+            for needle in [&b""[..], &b"ab"[..], expected, &b"xyz"[..], &b"\xff"[..]] {
+                assert_eq!(item.compare_key(needle, &bytes), expected.cmp(needle));
+            }
+        }
+        for (prefix, end_key) in [
+            (None, SliceIndexes(6, 5)),
+            (None, SliceIndexes(0, 7)),
+            (Some(SliceIndexes(3, 1)), SliceIndexes(0, 2)),
+            (Some(SliceIndexes(0, 7)), SliceIndexes(0, 2)),
+            (Some(SliceIndexes(0, 1)), SliceIndexes(5, 4)),
+            (Some(SliceIndexes(0, 1)), SliceIndexes(0, 7)),
+        ] {
+            let item = IndexBlockParsedItem {
+                offset: BlockOffset(17),
+                size: 4096,
+                prefix,
+                end_key,
+                seqno: 3,
+            };
+            assert!(std::panic::catch_unwind(|| item.materialize(&bytes)).is_err());
+            assert!(std::panic::catch_unwind(|| item.handle(&bytes)).is_err());
+            assert!(std::panic::catch_unwind(|| item.compare_key(b"key", &bytes)).is_err());
+        }
+    }
+}
