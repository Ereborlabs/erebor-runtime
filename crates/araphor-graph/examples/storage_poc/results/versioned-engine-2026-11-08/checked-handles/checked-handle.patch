--- a/src/table/index_block/mod.rs
+++ b/src/table/index_block/mod.rs
@@ -30,14 +30,32 @@ pub struct IndexBlockParsedItem {
     pub seqno: SeqNo,
 }
 
+impl IndexBlockParsedItem {
+    #[expect(
+        clippy::indexing_slicing,
+        reason = "keep key bounds checks before block I/O"
+    )]
+    pub(crate) fn handle(&self, bytes: &[u8]) -> BlockHandle {
+        if let Some(prefix) = &self.prefix {
+            let _ = &bytes[prefix.0..prefix.1];
+        }
+        let _ = &bytes[self.end_key.0..self.end_key.1];
+        BlockHandle::new(self.offset, self.size)
+    }
+}
+
 impl ParsedItem<KeyedBlockHandle> for IndexBlockParsedItem {
+    #[expect(
+        clippy::indexing_slicing,
+        reason = "keep checked native index key ranges"
+    )]
     fn compare_key(&self, needle: &[u8], bytes: &[u8]) -> std::cmp::Ordering {
         if let Some(prefix) = &self.prefix {
-            let prefix = unsafe { bytes.get_unchecked(prefix.0..prefix.1) };
-            let rest_key = unsafe { bytes.get_unchecked(self.end_key.0..self.end_key.1) };
+            let prefix = &bytes[prefix.0..prefix.1];
+            let rest_key = &bytes[self.end_key.0..self.end_key.1];
             compare_prefixed_slice(prefix, rest_key, needle)
         } else {
-            let key = unsafe { bytes.get_unchecked(self.end_key.0..self.end_key.1) };
+            let key = &bytes[self.end_key.0..self.end_key.1];
             key.cmp(needle)
