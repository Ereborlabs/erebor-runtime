     #[test]
+    #[expect(clippy::indexing_slicing)]
+    fn checksum_exact_reads_keep_errors() -> crate::Result<()> {
+        use std::{hash::Hasher, io::ErrorKind};
+
+        struct FaultRead<'a> {
+            bytes: &'a [u8],
+            failure: Option<ErrorKind>,
+            interrupt: bool,
+            calls: usize,
+        }
+        impl Read for FaultRead<'_> {
+            fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+                self.calls += 1;
+                if std::mem::take(&mut self.interrupt) {
+                    return Err(ErrorKind::Interrupted.into());
+                }
+                if self.bytes.is_empty() {
+                    return self.failure.map_or(Ok(0), |kind| Err(kind.into()));
+                }
+                let count = buffer.len().min(self.bytes.len()).min(11);
+                buffer[..count].copy_from_slice(&self.bytes[..count]);
+                self.bytes = &self.bytes[count..];
+                Ok(count)
+            }
+        }
+
+        let data: Vec<_> = (0..=255).cycle().take(512).collect();
+        for (bytes, failure) in [
+            (data.as_slice(), None),
+            (&data[..19], Some(ErrorKind::PermissionDenied)),
+        ] {
+            for capacity in [1, 7, 64] {
+                let mut reader = BufReader::with_capacity(
+                    capacity,
+                    FaultRead {
+                        bytes,
+                        failure,
+                        interrupt: true,
+                        calls: 0,
+                    },
+                );
+                let mut checksum = xxhash_rust::xxh3::Xxh3::default();
+                let mut input = ChecksumRead {
+                    reader: &mut reader,
+                    checksum: &mut checksum,
+                };
+                input.read_exact(&mut [])?;
+                assert_eq!(input.reader.get_ref().calls, 0);
+                let mut consumed = 0;
+                let mut failed = false;
+                for size in [1, 7, 16, 3, 257, 0, 31, 512] {
+                    let mut buffer = vec![0; size];
+                    let result = input.read_exact(&mut buffer);
+                    let end = (consumed + size).min(bytes.len());
+                    let mut expected = xxhash_rust::xxh3::Xxh3::default();
+                    expected.update(&bytes[..end]);
+                    assert_eq!(input.checksum.finish(), expected.finish());
+                    if let Err(error) = result {
+                        assert_eq!(error.kind(), failure.unwrap_or(ErrorKind::UnexpectedEof));
+                        assert_eq!(end, bytes.len());
+                        failed = true;
+                        break;
+                    }
+                    assert_eq!(buffer, bytes[consumed..end]);
+                    consumed = end;
+                }
+                assert!(failed);
+                assert!(!input.reader.get_ref().interrupt);
+                let calls = input.reader.get_ref().calls;
+                let digest = input.checksum.finish();
+                input.read_exact(&mut [])?;
+                assert_eq!(input.reader.get_ref().calls, calls);
+                assert_eq!(input.checksum.finish(), digest);
+            }
+        }
+        Ok(())
+    }
