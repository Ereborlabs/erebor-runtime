@@ -272,6 +276,33 @@ mod tests {
     use super::*;
     use test_log::test;
 
+    #[test]
+    #[expect(clippy::indexing_slicing)]
+    fn item_header_truncation() -> crate::Result<()> {
+        let item = Entry::Item {
+            keyspace_id: 0x0102_0304_0506_0708,
+            key: vec![0xab; 257].into(),
+            value: vec![0xcd; 513].into(),
+            value_type: ValueType::Value,
+            compression: CompressionType::None,
+        };
+        let bytes = item.encode_into_vec();
+        let header_end = bytes.len() - 257 - 513;
+        for end in 0..header_end {
+            let error = Entry::decode_from(&mut &bytes[..end]).expect_err("incomplete header");
+            let error = match (end, error) {
+                (2, crate::Error::Storage(lsm_tree::Error::Io(error))) => error,
+                (end, crate::Error::Io(error)) if end != 2 => error,
+                (_, error) => panic!("unexpected header error: {error:?}"),
+            };
+            assert_eq!(error.kind(), std::io::ErrorKind::UnexpectedEof);
+        }
+        let mut input = bytes.as_slice();
+        assert_eq!(Entry::decode_from(&mut input)?, item);
+        assert!(input.is_empty());
+        Ok(())
+    }
+
     #[cfg(feature = "lz4")]
     #[test]
     #[expect(clippy::cast_possible_truncation, clippy::indexing_slicing)]
