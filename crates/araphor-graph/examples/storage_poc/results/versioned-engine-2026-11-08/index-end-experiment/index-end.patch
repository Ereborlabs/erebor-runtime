@@ -65,6 +65,52 @@ mod tests {
     };
     use test_log::test;
 
+    #[test]
+    fn single_entry_sequence_bounds() -> crate::Result<()> {
+        let item = KeyedBlockHandle::new(b"key".into(), 5, BlockHandle::new(BlockOffset(0), 6_000));
+        let block = IndexBlock::new(Block {
+            data: IndexBlock::encode_into_vec(&[item])?.into(),
+            header: Header {
+                block_type: BlockType::Index,
+                checksum: Checksum::from_raw(0),
+                data_length: 0,
+                uncompressed_length: 0,
+            },
+        });
+
+        for cut in [0, 4, 5, 6] {
+            let mut iter = block.iter();
+            assert_eq!(iter.seek(b"key", cut), cut > 5);
+            if cut > 5 {
+                let entry = iter
+                    .next()
+                    .expect("one entry")
+                    .materialize(block.as_slice());
+                assert_eq!(entry.end_key().as_ref(), b"key");
+                assert_eq!(entry.seqno(), 5);
+            }
+            assert!(iter.next().is_none());
+            assert!(iter.next_back().is_none());
+        }
+
+        let mut iter = block.iter();
+        assert!(!iter.seek(b"later", 6));
+        assert!(iter.next().is_none());
+        assert!(iter.next_back().is_none());
+
+        let mut iter = block.iter();
+        assert!(iter.seek_upper(b"later", 6));
+        let entry = iter
+            .next_back()
+            .expect("one entry")
+            .materialize(block.as_slice());
+        assert_eq!(entry.end_key().as_ref(), b"key");
+        assert_eq!(entry.seqno(), 5);
+        assert!(iter.next().is_none());
+        assert!(iter.next_back().is_none());
+        Ok(())
+    }
+
