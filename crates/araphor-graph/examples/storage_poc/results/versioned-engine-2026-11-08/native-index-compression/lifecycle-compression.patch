+    #[cfg(feature = "lz4")]
+    #[test]
+    #[expect(clippy::cast_possible_truncation, clippy::indexing_slicing)]
+    fn compressed_items_keep_original_bytes() -> crate::Result<()> {
+        use rand::{Rng, SeedableRng};
+
+        let mut noise = vec![0; 70_000];
+        rand::rngs::StdRng::seed_from_u64(7).fill_bytes(&mut noise);
+        let values = [
+            Vec::new(),
+            noise,
+            vec![42],
+            vec![42; 32],
+            vec![42; 4096],
+            Vec::new(),
+        ];
+        let key = b"k\0\xff";
+        let prefix = [9, 8];
+        let mut buffer = Vec::new();
+        for value in values {
+            for compression in [CompressionType::None, CompressionType::Lz4] {
+                let payload = match compression {
+                    CompressionType::None => value.clone(),
+                    CompressionType::Lz4 => lz4_flex::compress(&value),
+                };
+                let mut expected = prefix.to_vec();
+                expected.write_u8(Tag::Item.into())?;
+                expected.write_u8(ValueType::Value.into())?;
+                compression.encode_into(&mut expected)?;
+                expected.write_u64::<LittleEndian>(42)?;
+                expected.write_u16::<LittleEndian>(key.len() as u16)?;
+                expected.write_u32::<LittleEndian>(value.len() as u32)?;
+                expected.write_u32::<LittleEndian>(payload.len() as u32)?;
+                expected.extend_from_slice(key);
+                expected.extend_from_slice(&payload);
+
+                buffer.clear();
+                buffer.extend_from_slice(&prefix);
+                serialize_marker_item(&mut buffer, 42, key, &value, ValueType::Value, compression)?;
+                assert_eq!(buffer, expected);
+                let mut reader = &buffer[prefix.len()..];
+                assert_eq!(
+                    Entry::decode_from(&mut reader)?,
+                    Entry::Item {
+                        keyspace_id: 42,
+                        key: key.as_slice().into(),
+                        value: value.clone().into(),
+                        value_type: ValueType::Value,
+                        compression,
+                    }
+                );
+                assert!(reader.is_empty());
+            }
+        }
+        Ok(())
+    }
+
