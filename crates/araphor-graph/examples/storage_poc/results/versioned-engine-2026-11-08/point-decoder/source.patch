+    #[test]
+    fn point_read_matches_oracle() -> crate::Result<()> {
+        use crate::table::block::hash_index::{MARKER_CONFLICT, MARKER_FREE};
+
+        let mut keys = vec![vec![0], vec![255]];
+        keys.extend((0..32).map(|idx| format!("key/{idx:02}").into_bytes()));
+        keys.sort_unstable();
+        let mut items = Vec::new();
+        for key in &keys {
+            items.push(InternalValue::from_components(
+                key.as_slice(),
+                b"current".as_slice(),
+                257,
+                Value,
+            ));
+            items.push(InternalValue::from_components(
+                key.as_slice(),
+                b"".as_slice(),
+                128,
+                Tombstone,
+            ));
+            items.push(InternalValue::from_components(
+                key.as_slice(),
+                b"".as_slice(),
+                0,
+                Value,
+            ));
+        }
+        let mut needles = keys;
+        needles.extend([
+            Vec::new(),
+            b"a".to_vec(),
+            b"key/".to_vec(),
+            b"key/16\0".to_vec(),
+            b"zz".to_vec(),
+            vec![255, 0],
+        ]);
+        let mut outcomes = [false; 4];
+        let mut widths = [false; 2];
+        for value_len in [7, 4096] {
+            for item in &mut items {
+                if item.key.seqno == 257 {
+                    item.value = vec![b'x'; value_len].into();
+                }
+            }
+            for restart in (1..=16).chain([255]) {
+                for ratio in [0.0, 0.25, 1.33, 8.0] {
+                    let bytes = DataBlock::encode_into_vec(&items, restart, ratio)?;
+                    let block = DataBlock::new(Block {
+                        data: bytes.into(),
+                        header: Header {
+                            block_type: BlockType::Data,
+                            checksum: Checksum::from_raw(0),
+                            data_length: 0,
+                            uncompressed_length: 0,
+                        },
+                    });
+                    let width = super::Trailer::new(&block.inner)
+                        .as_slice()
+                        .get(1)
+                        .copied()
+                        .expect("index width is present");
+                    match width {
+                        2 => widths[0] = true,
+                        4 => {
+                            widths[1] = true;
+                            let index = block.get_binary_index_reader();
+                            assert!(index.get(index.len() - 1) > usize::from(u16::MAX));
+                        }
+                        _ => panic!("invalid index width"),
+                    }
+                    for needle in &needles {
+                        let outcome = match block.get_hash_index_reader() {
+                            None => 0,
+                            Some(index) => match index.get(needle) {
+                                MARKER_FREE => 1,
+                                MARKER_CONFLICT => 2,
+                                _ => 3,
+                            },
+                        };
+                        outcomes[outcome] = true;
