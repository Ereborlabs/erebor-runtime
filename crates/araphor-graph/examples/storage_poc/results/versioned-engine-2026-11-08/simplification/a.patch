     }
     use std::time::Duration;
 
+    #[test]
+    fn retained_segment_order() -> crate::Result<()> {
+        let dir = tempfile::tempdir()?;
+        let (saved, expected, expired) = {
+            let db = SingleWriterTxDatabase::builder(&dir).journal_cdc().open()?;
+            let table = db.keyspace("records", KeyspaceCreateOptions::default)?;
+            let mut receipts = Vec::new();
+            for index in 0u64..16 {
+                let mut tx = db.write_tx();
+                tx.insert(&table, index.to_be_bytes(), index.to_be_bytes());
+                receipts.push(tx.commit_receipt()?.ok_or(crate::Error::Unrecoverable)?);
+                db.inner().rotate_journal()?;
+                if index % 4 == 0 {
+                    db.inner().rotate_journal()?;
+                }
+            }
+            table.as_ref().flush(true)?;
+            let saved = receipts[8].cursor;
+            db.inner().retain_after(saved)?;
+            db.inner().collect_journals()?;
+            for index in 16u64..20 {
+                let mut tx = db.write_tx();
+                tx.insert(&table, index.to_be_bytes(), index.to_be_bytes());
+                receipts.push(tx.commit_receipt()?.ok_or(crate::Error::Unrecoverable)?);
+                db.inner().rotate_journal()?;
+            }
+            {
+                let manager = db
+                    .inner()
+                    .supervisor
+                    .journal_manager
+                    .read()
+                    .map_err(|_| crate::Error::Poisoned)?;
+                let ids: Vec<_> = manager
+                    .items
+                    .iter()
+                    .map(|item| item.segment.as_ref().expect("sealed segment").id)
+                    .collect();
+                assert!(ids.windows(2).all(|pair| pair[0] < pair[1]));
+            }
+            let expected: Vec<_> = receipts[9..].iter().map(|commit| commit.cursor).collect();
+            let mut feed = db.inner().journal_feed(Some(saved))?;
+            assert_eq!(
+                feed.read()?
+                    .iter()
+                    .map(|batch| batch.cursor)
+                    .collect::<Vec<_>>(),
+                expected
+            );
+            let expired = receipts[0].cursor;
+            assert!(db
+                .inner()
+                .journal_feed(Some(expired))?
+                .next_batch()
+                .is_err());
+            (saved, expected, expired)
+        };
+        let db = SingleWriterTxDatabase::builder(&dir).open()?;
+        assert_eq!(
+            db.inner()
+                .journal_feed(Some(saved))?
+                .read()?
+                .iter()
+                .map(|batch| batch.cursor)
+                .collect::<Vec<_>>(),
+            expected
+        );
+        assert!(db
+            .inner()
+            .journal_feed(Some(expired))?
+            .next_batch()
+            .is_err());
+        Ok(())
+    }
+
     fn database(path: &Path) -> crate::Result<SingleWriterTxDatabase> {
         SingleWriterTxDatabase::builder(path).journal_cdc().open()
     }
