+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn shared_pins_preserve_cuts() -> crate::Result<()> {
+        let native = Arc::new(Retention::default());
+        let history = History::new(native.clone(), Revision(10));
+        let first = history.pin(10, 10, 10)?.expect("current cut");
+        let second = history.pin(10, 10, 10)?.expect("shared cut");
+        history.advance(Revision(20))?;
+        drop(first);
+        assert!(native.covers(10, 10));
+        assert!(history.pin(11, 11, 20)?.is_none());
+        drop(second);
+        assert!(!native.covers(10, 10));
+
+        let first = history.pin(20, u64::MAX, 20)?.expect("future range");
+        let second = history.pin(20, u64::MAX, 20)?.expect("shared range");
+        history.advance(Revision(30))?;
+        drop(first);
+        assert!(native.covers(20, u64::MAX));
+        drop(second);
+        assert!(!native.covers(20, 20));
+        assert!(native.covers(30, u64::MAX));
+        Ok(())
     }
 }
