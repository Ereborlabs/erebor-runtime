+    #[test]
+    fn contributions_keep_their_owners() -> crate::Result<()> {
+        let native = Arc::new(Retention::default());
+        let history = History::new(native.clone(), Revision(30));
+        let policy = Protection::Policy(RetentionId(1));
+        let fork = Protection::Fork(super::super::BranchId(1));
+        history.set_range(policy, Some((10, 20)))?;
+        history.set_range(fork, Some((15, 15)))?;
+        assert!(native.covers(10, 20));
+        history.set_range(policy, None)?;
+        assert!(!native.covers(10, 10));
+        assert!(native.covers(15, 15));
+        history.set_range(fork, None)?;
+        assert!(!native.covers(15, 15));
+        assert!(native.covers(30, u64::MAX));
+        Ok(())
+    }
+
+    #[test]
+    fn changes_skip_other_branches() -> crate::Result<()> {
+        use crate::SingleWriterTxDatabase;
+        let dir = tempfile::tempdir()?;
+        let db = SingleWriterTxDatabase::builder(&dir).versioned().open()?;
+        let main = db.create_branch("main")?;
+        let other = db.create_branch("other")?;
+        let history = db.catalogue(|catalogue| Ok(catalogue.entry(other.id())?.history.clone()))?;
+        let guard = history.state.lock().map_err(|_| crate::Error::Poisoned)?;
+        let (send, receive) = std::sync::mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            let result = (|| -> crate::Result<()> {
+                let cut = main.info()?.head;
+                let policy = main.retain_history(cut..)?;
+                let child = main.fork("child", cut)?;
+                let child_policy = child.retain_history(child.info()?.head..)?;
+                db.release_history(policy)?;
+                db.delete_branch(child.id())?;
+                db.release_history(child_policy)?;
+                db.inner().flush_memtables()?;
+                db.inner().rotate_journal()?;
+                let mut tx = main.write_tx()?;
+                tx.insert("key", "after fork");
+                let commit = tx.commit()?.ok_or(crate::Error::Unrecoverable)?;
+                db.inner().retain_after(commit.cursor)?;
+                db.inner().collect_journals()?;
+                assert!(db.branch_by_id(child.id())?.is_none());
+                Ok(())
+            })();
+            send.send(result).is_ok()
+        });
+        let result = receive.recv_timeout(std::time::Duration::from_secs(5));
+        drop(guard);
+        assert!(worker.join().map_err(|_| crate::Error::Poisoned)?);
+        result.map_err(|_| crate::Error::Poisoned)??;
+        Ok(())
+    }
 }
