+#[test]
+fn cut_survives_empty_journal() -> crate::Result<()> {
+    use crate::SingleWriterTxDatabase;
+    let dir = tempfile::tempdir()?;
+    let (id, commit) = {
+        let db = SingleWriterTxDatabase::builder(&dir).versioned().open()?;
+        let branch = db.create_branch("main")?;
+        let mut tx = branch.write_tx()?;
+        tx.insert("key", "retained");
+        let commit = tx.commit()?.ok_or(crate::Error::Unrecoverable)?;
+        db.inner().flush_memtables()?;
+        db.inner().major_compact()?;
+        db.inner().rotate_journal()?;
+        {
+            let mut manager = db
+                .inner()
+                .supervisor
+                .journal_manager
+                .write()
+                .map_err(|_| crate::Error::Poisoned)?;
+            let signal = manager.cdc.take();
+            let result = manager.maintenance();
+            manager.cdc = signal;
+            result?;
+            assert!(manager.items.is_empty());
+        }
+        (branch.id(), commit)
+    };
+    let db = SingleWriterTxDatabase::builder(&dir).open()?;
+    let branch = db.branch_by_id(id)?.ok_or(crate::Error::Unrecoverable)?;
+    assert_eq!(db.inner().journal_head()?, None);
+    assert_eq!(branch.info()?.head, commit.revision);
+    let view = branch.snapshot()?;
+    assert_eq!(view.revision(), commit.revision);
+    assert_eq!(view.cursor()?, None);
+    assert_eq!(view.get("key")?.as_deref(), Some(b"retained".as_slice()));
+    assert_eq!(branch.read_at(commit.revision)?.cursor()?, None);
+    let mut tx = branch.write_tx()?;
+    tx.insert("key", "continued");
+    let next = tx.commit()?.ok_or(crate::Error::Unrecoverable)?;
+    assert!(next.revision > commit.revision);
+    assert_eq!(branch.snapshot()?.cursor()?, Some(next.cursor));
+    assert_eq!(view.get("key")?.as_deref(), Some(b"retained".as_slice()));
+    Ok(())
+}
