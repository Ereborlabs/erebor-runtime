{
  "apiVersion": "mithril.erebor.dev/v1alpha1",
  "kind": "WorkloadProtectionPolicy",
  "metadata": {"name": "mount-observe"},
  "spec": {
    "podSelector": {"matchLabels": {"app.kubernetes.io/name": "pid-reuse"}},
    "mode": "Observe",
    "containers": [{
      "names": ["worker"],
      "kinds": ["Application"],
      "images": ["fixture/python@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],
      "applicationEntry": {"executionRule": "python", "role": "worker"},
      "additionalEntries": [],
      "administrativeEntry": {"role": "external"},
      "externalRole": "external"
    }],
    "roles": [{
      "name": "worker",
      "files": [
        {"name": "allow-open", "path": "/work/mount/allowed/open", "recursive": false, "operations": ["OpenRead"], "action": "Allow"},
        {"name": "allow-result", "path": "/work/mount-result.json", "recursive": false, "operations": ["OpenWrite", "Write"], "action": "Allow"}
      ],
      "execution": [{"name": "python", "path": "/usr/bin/python3", "recursive": false, "operations": ["Execute"], "action": "Allow"}],
      "capabilities": [{"name": "allow-sys-admin", "capabilities": ["SysAdmin"], "action": "Allow"}],
      "network": {"destinations": []},
      "processControl": [],
      "unixStreams": []
    }, {
      "name": "external",
      "files": [],
      "execution": [],
      "network": {"destinations": []},
      "processControl": [],
      "unixStreams": []
    }]
  }
}
