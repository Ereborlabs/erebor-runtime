{
  "apiVersion": "mithril.erebor.dev/v1alpha1",
  "kind": "WorkloadProtectionPolicy",
  "metadata": {
    "name": "path-wildcards",
    "namespace": "default",
    "uid": "10000000-0000-4000-8000-000000000021",
    "generation": 1,
    "resourceVersion": "1"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "pid-reuse"
      },
      "matchExpressions": []
    },
    "mode": "Protect",
    "containers": [
      {
        "names": ["worker"],
        "kinds": ["Application"],
        "images": [
          "fixture/python@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        ],
        "applicationEntry": {
          "executionRule": "python",
          "role": "worker"
        },
        "additionalEntries": [],
        "administrativeEntry": {
          "role": "administrator"
        },
        "externalRole": "external"
      }
    ],
    "roles": [
      {
        "name": "worker",
        "files": [
          {
            "name": "allow-control",
            "path": "/work/wildcard/allowed/open",
            "recursive": false,
            "operations": ["OpenRead"],
            "action": "Allow"
          },
          {
            "name": "allow-result",
            "path": "/work/wildcard-result.json",
            "recursive": false,
            "operations": ["OpenWrite", "Write"],
            "action": "Allow"
          }
        ],
        "pathTreeDenials": [
          {
            "name": "deny-user-secrets",
            "path": "/work/wildcard/home/*/secrets",
            "operations": ["OpenRead"]
          },
          {
            "name": "deny-nested-secrets",
            "path": "/work/wildcard/srv/**/secrets",
            "operations": ["OpenRead"]
          },
          {
            "name": "deny-created-child",
            "path": "/work/wildcard/create-denied",
            "operations": ["Create"]
          }
        ],
        "execution": [
          {
            "name": "python",
            "path": "/usr/bin/python3",
            "recursive": false,
            "operations": ["Execute"],
            "action": "Allow"
          }
        ],
        "network": {
          "socketControls": [],
          "destinations": []
        },
        "processControl": [],
        "unixStreams": []
      },
      {
        "name": "administrator",
        "files": [],
        "execution": [],
        "network": {
          "socketControls": [],
          "destinations": []
        },
        "processControl": [],
        "unixStreams": []
      },
      {
        "name": "external",
        "files": [],
        "execution": [],
        "network": {
          "socketControls": [],
          "destinations": []
        },
        "processControl": [],
        "unixStreams": []
      }
    ],
    "exceptionGrants": []
  }
}
