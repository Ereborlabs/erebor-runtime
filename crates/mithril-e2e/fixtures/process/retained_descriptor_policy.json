{
  "apiVersion": "mithril.erebor.dev/v1alpha1",
  "kind": "WorkloadProtectionPolicy",
  "metadata": {
    "name": "retained-descriptor",
    "namespace": "default",
    "uid": "10000000-0000-4000-8000-000000000022",
    "generation": 1,
    "resourceVersion": "1"
