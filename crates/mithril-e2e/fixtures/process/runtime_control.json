{
  "ociVersion": "1.0.2",
  "process": {
    "terminal": false,
    "user": { "uid": 65532, "gid": 65532, "additionalGids": [65532] },
    "args": [],
    "env": ["PATH=/usr/bin:/bin", "PYTHONDONTWRITEBYTECODE=1"],
    "cwd": "/",
    "capabilities": {
      "bounding": [],
      "effective": [],
      "permitted": [],
      "inheritable": [],
      "ambient": []
    },
    "noNewPrivileges": true
  },
  "root": { "path": "rootfs", "readonly": true },
  "mounts": [
    { "destination": "/proc", "type": "proc", "source": "proc" },
    { "destination": "/dev", "type": "tmpfs", "source": "tmpfs" },
    { "destination": "/usr", "type": "bind", "source": "/usr", "options": ["rbind", "ro"] },
    { "destination": "/lib", "type": "bind", "source": "/lib", "options": ["rbind", "ro"] },
    { "destination": "/lib64", "type": "bind", "source": "/lib64", "options": ["rbind", "ro"] },
    { "destination": "/owner", "type": "bind", "source": "MITHRIL_FIXTURES/runtime_owner.py", "options": ["bind", "ro"] },
    { "destination": "/result", "type": "bind", "source": "MITHRIL_WORK", "options": ["rbind", "rw"] }
  ],
  "linux": {
    "cgroupsPath": "MITHRIL_CGROUP",
    "namespaces": [
      { "type": "pid" },
      { "type": "network" },
      { "type": "ipc" },
      { "type": "uts" },
      { "type": "mount" }
    ]
  },
  "annotations": {
    "io.kubernetes.cri.container-type": "container",
    "io.kubernetes.cri.container-id": "MITHRIL_ID"
  }
}
