{
  "apiVersion": "mithril.erebor.dev/v1alpha1",
  "kind": "WorkloadProtectionPolicy",
  "metadata": {
    "name": "socket-cross",
    "namespace": "default",
    "uid": "10000000-0000-4000-8000-000000000072",
    "generation": 1,
    "resourceVersion": "1"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {"app.kubernetes.io/name": "pid-reuse"}
    },
    "mode": "Protect",
    "containers": [{
      "names": ["worker"],
      "kinds": ["Application"],
      "images": ["fixture/python@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],
      "applicationEntry": {"executionRule": "python", "role": "worker"},
      "additionalEntries": [],
      "administrativeEntry": {"role": "administrator"},
      "externalRole": "restricted"
    }],
    "roles": [
      {
        "name": "worker",
        "files": [],
        "execution": [{
          "name": "python", "path": "/usr/bin/python3", "recursive": false,
          "operations": ["Execute"], "action": "Allow"
        }],
        "network": {"destinations": [{
          "name": "loopback-pass", "operations": ["Bind", "Connect", "Send", "Receive"],
          "protocols": ["TCP"], "cidrs": ["127.0.0.1/32"],
          "ports": [{"first": 19097, "last": 19098}], "action": "Allow"
        }]},
        "processControl": [],
        "unixStreams": [{
          "name": "worker-restricted", "peerRoles": ["restricted"], "action": "Allow"
        }]
      },
      {
        "name": "administrator", "files": [], "execution": [],
        "network": {"destinations": []}, "processControl": [], "unixStreams": []
      },
      {
        "name": "restricted",
        "files": [{
          "name": "control-socket", "path": "/work/cross-pass.sock", "recursive": false,
          "operations": ["Create"], "action": "Allow"
        }],
        "execution": [],
        "network": {"destinations": []}, "processControl": [],
        "unixStreams": [{
          "name": "restricted-worker", "peerRoles": ["worker"], "action": "Allow"
        }]
      }
    ],
    "exceptionGrants": []
  }
}
