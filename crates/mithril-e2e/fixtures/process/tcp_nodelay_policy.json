          ]
        },
        "processControl": [],
        "unixStreams": []
      },
      {
        "name": "administrator",
        "files": [],
        "execution": [],
        "network": {"destinations": []},
        "processControl": [],
        "unixStreams": []
      },
      {
        "name": "external",
        "files": [],
        "execution": [],
        "network": {"destinations": []},
        "processControl": [],
        "unixStreams": []
      }
    ],
    "exceptionGrants": []
  }
