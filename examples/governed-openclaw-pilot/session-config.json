{
  "policies": [
    "policy.json"
  ],
  "audit": {
    "surfaces": {
      "terminal": {
        "level": "signal"
      }
    }
  },
  "session": {
    "enabled": true,
    "actor": {
      "id": "openclaw",
      "kind": "agent"
    },
    "workspace": "../..",
    "diagnostics": [
      {
        "name": "prompt",
        "description": "Print the prompt that the governed OpenClaw demo sends to the agent.",
        "command": [
          "sed",
          "-n",
          "1,80p",
          "examples/governed-openclaw-pilot/prompt.txt"
        ]
      }
    ],
    "runner": {
      "kind": "linux_host"
    }
  },
  "surfaces": {
    "terminal": {
      "enabled": true,
      "tty": true
    },
    "browser_cdp": {
      "enabled": true,
      "listen": "127.0.0.1:0",
      "browser": {
        "headless": false
      }
    }
  }
}
