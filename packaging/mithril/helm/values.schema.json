{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["node", "control"],
  "properties": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "imagePullPolicy",
        "logFilter",
        "configHostPath",
        "identityHostPath",
        "stateHostPath",
        "runHostPath",
        "containerRuntimeSocket",
        "nodeSelector",
        "affinity",
        "runtimeHook"
      ],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "logFilter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n]+$"
        },
        "configHostPath": {"type": "string", "pattern": "^/"},
        "identityHostPath": {"type": "string", "pattern": "^/"},
        "stateHostPath": {"type": "string", "pattern": "^/"},
        "runHostPath": {"type": "string", "pattern": "^/"},
        "containerRuntimeSocket": {"type": "string", "pattern": "^/"},
        "nodeSelector": {"type": "object"},
        "affinity": {"type": "object"},
        "runtimeHook": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "install",
            "injector",
            "cleanupImage",
            "cleanupImagePullPolicy",
            "hostBinaryDirectory",
            "hostConfigDirectory",
            "socketPath",
            "timeoutMs",
            "runtimeTimeoutSeconds"
          ],
          "properties": {
            "install": {"type": "boolean"},
            "injector": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "image",
                "imagePullPolicy",
                "hostSocketPath",
                "pluginIndex"
              ],
              "properties": {
                "enabled": {"type": "boolean"},
                "image": {"type": "string", "minLength": 1},
                "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
                "hostSocketPath": {"type": "string", "pattern": "^/"},
                "pluginIndex": {"type": "string", "pattern": "^[0-9]{2}$"}
              }
            },
            "cleanupImage": {"type": "string", "minLength": 1},
            "cleanupImagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
            "hostBinaryDirectory": {"type": "string", "pattern": "^/"},
            "hostConfigDirectory": {"type": "string", "pattern": "^/"},
            "socketPath": {"type": "string", "pattern": "^/run/mithril/[^/]+$"},
            "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 30000},
            "runtimeTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30}
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "imagePullPolicy",
        "logFilter",
        "configSecretName",
        "statePersistentVolumeClaim",
        "grpcPort",
        "nodeSelector",
        "admission"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "logFilter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n]+$"
        },
        "configSecretName": {"type": "string", "minLength": 1},
        "statePersistentVolumeClaim": {"type": "string", "minLength": 1},
        "grpcPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "nodeSelector": {"type": "object"},
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "port",
            "tlsSecretName",
            "caBundle",
            "webhookTimeoutSeconds"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "tlsSecretName": {"type": "string", "minLength": 1},
            "caBundle": {"type": "string"},
            "webhookTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30}
          }
        }
      }
    }
  }
}
